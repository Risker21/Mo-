# Mo小窝 环境变量配置
# 复制为 .env 后填写，本地运行: npm run dev
# 部署到 Netlify 时：Site settings → Environment variables 添加同名变量

# Supabase 数据库（从 Supabase Project Settings → API 获取）
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here

# JWT 密钥（使用随机字符串，至少 32 位）
JWT_SECRET=your-random-jwt-secret-at-least-32-chars

# SMTP 邮件配置（用于发送邮箱验证码，可用搜狐/QQ/163等）
# 未配置时验证码会打印到控制台（开发模式）
# MAIL_HOST=smtp.sohu.com
# MAIL_PORT=465
# MAIL_USER=your_email@sohu.com
# MAIL_PASS=your_smtp_password_or_auth_code
# MAIL_FROM_NAME=Mo小窝

# AI 聊天配置（OpenAI 兼容格式）
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# 星空云验证码配置（从星空云获取）
API_ID=
API_KEY=
