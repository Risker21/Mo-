# Mo小窝 环境变量配置
# 复制为 .env 后填写，本地运行: npm run dev
# 部署到 Netlify 时：Site settings → Environment variables 添加同名变量

# Supabase 数据库（从 Supabase Project Settings → API 获取）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# JWT 密钥（使用随机字符串，至少 32 位）
JWT_SECRET=

# SMTP 邮件配置（用于发送邮箱验证码）
# 未配置时验证码会打印到控制台（开发模式）
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=

# AI 聊天配置（OpenAI 兼容格式）
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# 星空云验证码配置
API_ID=
API_KEY=
